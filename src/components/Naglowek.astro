---
// Naglowek.astro — przyklejony pas w jednej linii. Progi zapytaniem kontenera (motyw.css), nie oknem (potwor-ux-ui §G1).
// Telefon: przełącznik menu (aria-expanded, Esc, klik poza panelem, inert na main i stopce).
import { t } from '../lib/tekst';

const sciezka = Astro.url.pathname;
const pozycje = [
  { adres: '/blog/', nazwa: t('interfejs.menu_blog'), prefiks: '/blog/' },
  { adres: '/z-naszych-stron/', nazwa: t('interfejs.menu_zNaszychStron'), prefiks: '/z-naszych-stron/' },
  { adres: '/o-nas/', nazwa: t('interfejs.menu_oNas'), prefiks: '/o-nas/' },
];
---

<header class="naglowek" id="naglowek">
  <div class="naglowek__pas kontener">
    <a class="marka" href="/" aria-label={t('interfejs.marka_aria')} aria-current={sciezka === '/' ? 'page' : undefined}>
      <svg class="marka__znak" viewBox="0 0 36 36" aria-hidden="true" focusable="false">
        <circle cx="18" cy="18" r="16.5" fill="none" stroke="#f6f0e4" stroke-width="1.5"></circle>
        <path d="M18 5 L22.2 18 L18 31 L13.8 18 Z" fill="#e9b48f"></path>
        <path d="M5 18 L18 13.8 L31 18 L18 22.2 Z" fill="none" stroke="#f6f0e4" stroke-width="1.5" stroke-linejoin="round"></path>
        <circle cx="18" cy="18" r="2" fill="#0f3e47"></circle>
      </svg>
      <span>{t('marka.nazwa')}</span>
    </a>
    <button
      class="menu-przelacznik"
      type="button"
      aria-expanded="false"
      aria-controls="menu-glowne"
      aria-label={t('interfejs.menu_otworz')}
      data-otworz={t('interfejs.menu_otworz')}
      data-zamknij={t('interfejs.menu_zamknij')}
    >
      <svg class="ikona-otworz" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
      <svg class="ikona-zamknij" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6L6 18"></path></svg>
      <span class="menu-przelacznik__napis" aria-hidden="true">{t('interfejs.menu_otworz')}</span>
    </button>
    <nav class="menu" id="menu-glowne" aria-label={t('interfejs.menu_aria')}>
      <ul>
        {
          pozycje.map((p) => (
            <li>
              <a href={p.adres} aria-current={sciezka.startsWith(p.prefiks) ? 'page' : undefined}>{p.nazwa}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<noscript>
  <style>
    .menu-przelacznik { display: none; }
    .menu { display: block; }
    .menu ul { display: flex; flex-wrap: wrap; gap: 0 1rem; }
  </style>
</noscript>

<script>
  const naglowek = document.getElementById('naglowek') as HTMLElement;
  const przelacznik = naglowek.querySelector<HTMLButtonElement>('.menu-przelacznik')!;
  const menu = document.getElementById('menu-glowne') as HTMLElement;
  const html = document.documentElement;
  const zablokowane = () => document.querySelectorAll<HTMLElement>('main, footer');
  // Tryb panelu rozpoznajemy z CSS (przełącznik widoczny), nie z szerokości okna: jeden próg w jednym miejscu.
  const panelAktywny = () => getComputedStyle(przelacznik).display !== 'none';

  const ustaw = (otwarte: boolean) => {
    przelacznik.setAttribute('aria-expanded', String(otwarte));
    przelacznik.setAttribute('aria-label', (otwarte ? przelacznik.dataset.zamknij : przelacznik.dataset.otworz) ?? '');
    if (otwarte) naglowek.setAttribute('data-otwarte', '');
    else naglowek.removeAttribute('data-otwarte');
    html.classList.toggle('menu-otwarte', otwarte);
    zablokowane().forEach((el) => (el.inert = otwarte));
  };

  przelacznik.addEventListener('click', () => ustaw(przelacznik.getAttribute('aria-expanded') !== 'true'));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && przelacznik.getAttribute('aria-expanded') === 'true') {
      ustaw(false);
      przelacznik.focus();
    }
  });
  menu.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) ustaw(false);
  });
  window.addEventListener('resize', () => {
    if (!panelAktywny() && przelacznik.getAttribute('aria-expanded') === 'true') ustaw(false);
  });
</script>
