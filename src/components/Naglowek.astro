---
// Naglowek.astro — przyklejony pas w jednej linii. Progi zapytaniem kontenera (motyw.css), nie oknem (potwor-ux-ui §G1).
// Menu z teksty.json `menu` (7 pozycji); próg pasa w motyw.css zmierzony CDP dla tych 7 pozycji.
// Telefon: przełącznik menu (aria-expanded, Esc, klik poza panelem, inert na main i stopce).
// Szkło: data-naglowek → Ruch.astro dodaje data-przewiniety po 40 px; wtedy tło --szklo-tlo-mocne + rozmycie.
// nadHero: przezroczysty nad pełnoekranowym zdjęciem (jasny tekst, przyciemnienie od góry), dopóki strona stoi na górze.
import { t, pobierz } from '../lib/tekst';

interface Props {
  /** Adres działu, który menu ma podświetlić, gdy strona nie leży pod jego adresem (wpis /blog/<slug>/ → /<dzial>/). */
  podswietl?: string;
  /** Strona z pełnoekranowym zdjęciem na górze <main> (Bazowy `heroPelny`). */
  nadHero?: boolean;
}
const { podswietl, nadHero = false } = Astro.props;
const sciezka = Astro.url.pathname;
// Pozycje menu z teksty.json `menu` [{nazwa, adres}] — kolejność pliku = kolejność w pasie.
const pozycje = (Array.isArray(pobierz('menu')) ? (pobierz('menu') as { nazwa?: unknown; adres?: unknown }[]) : [])
  .filter((p): p is { nazwa: string; adres: string } => typeof p?.nazwa === 'string' && typeof p?.adres === 'string')
  .map((p) => ({ ...p, biezaca: p.adres === podswietl || (p.adres !== '/' && sciezka.startsWith(p.adres)) }));
---

<header class:list={['naglowek', { 'naglowek--nad-hero': nadHero }]} id="naglowek" data-naglowek>
  <div class="naglowek__pas kontener">
    <a class="marka" href="/" aria-label={t('interfejs.marka_aria')} aria-current={sciezka === '/' ? 'page' : undefined}>
      <svg class="marka__znak" viewBox="0 0 36 36" aria-hidden="true" focusable="false">
        <circle cx="18" cy="18" r="16.5" fill="none" stroke="#f6f0e4" stroke-width="1.5"></circle>
        <path d="M18 5 L22.2 18 L18 31 L13.8 18 Z" fill="#e9b48f"></path>
        <path d="M5 18 L18 13.8 L31 18 L18 22.2 Z" fill="none" stroke="#f6f0e4" stroke-width="1.5" stroke-linejoin="round"></path>
        <circle cx="18" cy="18" r="2" fill="#0f3e47"></circle>
      </svg>
      <span>{t('marka.nazwa')}</span>
    </a>
    <button
      class="menu-przelacznik"
      type="button"
      aria-expanded="false"
      aria-controls="menu-glowne"
      aria-label={t('interfejs.menu_otworz')}
      data-otworz={t('interfejs.menu_otworz')}
      data-zamknij={t('interfejs.menu_zamknij')}
    >
      <svg class="ikona-otworz" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
      <svg class="ikona-zamknij" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6L6 18"></path></svg>
      <span class="menu-przelacznik__napis" aria-hidden="true">{t('interfejs.menu_otworz')}</span>
    </button>
    <nav class="menu" id="menu-glowne" aria-label={t('interfejs.menu_aria')}>
      <ul>
        {
          pozycje.map((p) => (
            <li>
              <a href={p.adres} aria-current={p.biezaca ? (sciezka === p.adres ? 'page' : 'true') : undefined}><span class="link-rosnacy">{p.nazwa}</span></a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<noscript>
  <style>
    .menu-przelacznik { display: none; }
    .menu { display: block; }
    .menu ul { display: flex; flex-wrap: wrap; gap: 0 1rem; }
  </style>
</noscript>

<style>
  /* Stany pasa (szkło po przewinięciu, „nad hero”, otwarte menu, pasek postępu) są w motyw.css (W1: [data-przewiniety],
     .naglowek--nad-hero). Tu tylko to, czego tam nie ma. */

  /* Otwarte menu telefonu BEZ backdrop-filter: filtr robi z pasa blok zawierający dla position: fixed i panel menu
     (inset od --wys-naglowka do dołu okna) zapadłby się do wysokości pasa, gdy menu otwiera się po przewinięciu. */
  .naglowek[data-otwarte] {
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
    text-shadow: none;
  }

  /* Fokus 3 px brzoskwinia (#e9b48f) na morzu — terakota #a8452a na morzu byłaby niewidoczna. */
  .marka:focus-visible,
  .menu a:focus-visible,
  .menu-przelacznik:focus-visible {
    outline: 3px solid var(--na-morzu-akcent);
    outline-offset: 2px;
  }

  /* Pozycje menu: podkreślenie rośnie od lewej; w pasie bez linii spoczynkowej .link-rosnacy (pas to nawigacja,
     rozpoznawalna położeniem), bieżąca pozycja ma linię pełną. */
  .menu a:hover,
  .menu a[aria-current] {
    text-decoration: none;
  }

  .menu .link-rosnacy {
    background-size: 0% 2px, 0% 1px;
  }

  .menu a:hover .link-rosnacy,
  .menu a:focus-visible .link-rosnacy,
  .menu a[aria-current] .link-rosnacy {
    background-size: 100% 2px, 0% 1px;
  }

  /* Marka większa tam, gdzie pas ma zapas (zmierzony próg menu 61 rem + ok. 2,5 rem na większy krój). */
  @container naglowek (min-width: 72rem) {
    .marka {
      font-size: 1.625rem;
    }

    .marka__znak {
      width: 2.5rem;
      height: 2.5rem;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .menu-przelacznik:active {
      transform: scale(0.98);
    }
  }
</style>

<script>
  const naglowek = document.getElementById('naglowek') as HTMLElement;
  const przelacznik = naglowek.querySelector<HTMLButtonElement>('.menu-przelacznik')!;
  const menu = document.getElementById('menu-glowne') as HTMLElement;
  const html = document.documentElement;
  const zablokowane = () => document.querySelectorAll<HTMLElement>('main, footer');
  // Tryb panelu rozpoznajemy z CSS (przełącznik widoczny), nie z szerokości okna: jeden próg w jednym miejscu.
  const panelAktywny = () => getComputedStyle(przelacznik).display !== 'none';

  const ustaw = (otwarte: boolean) => {
    przelacznik.setAttribute('aria-expanded', String(otwarte));
    przelacznik.setAttribute('aria-label', (otwarte ? przelacznik.dataset.zamknij : przelacznik.dataset.otworz) ?? '');
    if (otwarte) naglowek.setAttribute('data-otwarte', '');
    else naglowek.removeAttribute('data-otwarte');
    html.classList.toggle('menu-otwarte', otwarte);
    zablokowane().forEach((el) => (el.inert = otwarte));
  };

  przelacznik.addEventListener('click', () => ustaw(przelacznik.getAttribute('aria-expanded') !== 'true'));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && przelacznik.getAttribute('aria-expanded') === 'true') {
      ustaw(false);
      przelacznik.focus();
    }
  });
  menu.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) ustaw(false);
  });
  window.addEventListener('resize', () => {
    if (!panelAktywny() && przelacznik.getAttribute('aria-expanded') === 'true') ustaw(false);
  });
</script>
