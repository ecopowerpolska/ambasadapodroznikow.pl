---
// PomocnikPakowania.astro — darmowy pomocnik pakowania (2026-11-18, runda 2). Formularz bez wysyłki; wszystko liczy przeglądarka.
// Cała lista (src/data/pakowanie.json) jest w HTML jako ukryte pozycje z filtrami w atrybutach data-*;
// skrypt niżej pokazuje pasujące, liczy ilości, dobiera klimat z celu i dat (public/dane/klimat.json, ładowany leniwie),
// uwzględnia trasę (kraj startu i celu, public/dane/kraje.json: dowód/paszport, EKUZ, waluta, gniazdka),
// pozwala usuwać pozycje, dopisywać własne, zapisać listę do pliku .txt i wgrać ją z powrotem; stan trzyma w localStorage
// (klucz ambasada-pakowanie: ustawienia, odhaczenia, własne i usunięte pozycje, data). Bez JS widać formularz i komunikat.
import '../styles/narzedzia.css';
import dane from '../data/pakowanie.json';
import { adresWpisu, opublikowane } from '../lib/wpisy';

type Pozycja = {
  id: string;
  nazwa: string;
  kat: string;
  ilosc: string;
  os?: boolean;
  kto?: string[];
  klimat?: string[];
  aktywnosci?: string[];
  deszcz?: boolean;
  transport?: string[];
  sklad?: string[];
  min_dni?: number;
  min_dni_podreczny?: number;
  podreczny?: string;
  max_podreczny?: number;
  jedn?: string;
  uwaga?: string;
  trasa?: string;
  link?: boolean;
  blog?: boolean;
  warianty?: Record<string, { n?: string; u?: string; l?: boolean; k?: string }>;
  bez_akt?: string[];
  noc?: string;
  plyn?: boolean;
  uwaga_samolot?: string;
  kalk?: boolean;
};

// Link do wpisu o międzynarodowym prawie jazdy: wpis ma datę 7.12.2026, więc link wchodzi do HTML dopiero, gdy wpis jest opublikowany
// (ta sama funkcja, którą filtrowane są daty przyszłe); do tego czasu adres dałby 404. Przebudowa w Actions z harmonogramu włączy go sama.
const WPIS_MPJ = 'miedzynarodowe-prawo-jazdy-jak-zdobyc-ile-kosztuje';
const POKAZ_LINK_MPJ = (await opublikowane()).some((w) => w.id === WPIS_MPJ);
const BLOG_MPJ = adresWpisu(WPIS_MPJ);
const przedmioty = dane.przedmioty as Pozycja[];
const kategorie = dane.kategorie.map((k) => ({ ...k, pozycje: przedmioty.filter((p) => p.kat === k.id) }));
const lista = (w?: string[]) => (w && w.length ? w.join(' ') : undefined);

const KTO = [
  ['kobieta', 'Kobieta'],
  ['mezczyzna', 'Mężczyzna'],
  ['para', 'Para'],
  ['para_dzieci', 'Para z dziećmi'],
  ['sam_dzieci', 'Sam(a) z dziećmi'],
];
const PARA = [
  ['km', 'Kobieta i mężczyzna'],
  ['kk', 'Dwie kobiety'],
  ['mm', 'Dwóch mężczyzn'],
];
const RODZIC = [
  ['kobieta', 'Kobieta'],
  ['mezczyzna', 'Mężczyzna'],
];
const WIEK = [
  ['niemowle', 'Niemowlę (0–2 lata)'],
  ['dziecko', 'Dziecko (3–12 lat)'],
  ['nastolatek', 'Nastolatek (13–17 lat)'],
];
const KLIMAT = [
  ['cieplo', 'Ciepło'],
  ['umiarkowanie', 'Umiarkowanie'],
  ['zimno', 'Zimno'],
];
const AKT = [
  ['plaza', 'Plażowanie i kąpiele'],
  ['zwiedzanie', 'Zwiedzanie miasta'],
  ['wedrowki', 'Wędrówki i góry'],
  ['narty', 'Narty i snowboard'],
  ['rower', 'Rower'],
  ['wodne', 'Sporty wodne i nurkowanie'],
  ['bieganie', 'Bieganie, siłownia'],
  ['kemping', 'Kemping i namiot'],
  ['praca', 'Praca, konferencja'],
  ['uroczystosc', 'Uroczystość, elegancko'],
];
const TRANSPORT = [
  ['samolot', 'Samolot'],
  ['samochod', 'Własny samochód'],
  ['pociag', 'Pociąg lub autokar'],
];
// Ustawienia domyślne = stan HTML (pierwsze wejście bez zapisu nie przesuwa układu).
const DOM = { sklad: 'para', para: 'km', rodzic: 'kobieta', dzieci: '1', klimat: 'umiarkowanie', akt: 'zwiedzanie', transport: 'samolot', dni: 7 };
---

<div class="pk" data-pakowanie>
  <p class="pk-przywrocono" data-pk-przywrocono hidden>
    <span data-pk-przywrocono-tekst></span>
    <button class="guzik guzik--obrys pk-od-nowa" type="button" data-pk-od-nowa>Zacznij od nowa</button>
  </p>

  <form class="nz-form szklo szklo--jasne" data-pk-form aria-label="Parametry wyjazdu">
    <div class="nz-grupa">
      <label class="nz-legenda" for="pk-skad">Skąd jedziesz?</label>
      <input
        class="nz-wejscie"
        id="pk-skad"
        name="skad"
        type="text"
        role="combobox"
        aria-expanded="false"
        aria-controls="pk-skad-lb"
        aria-autocomplete="list"
        autocomplete="off"
        autocapitalize="off"
        spellcheck="false"
        maxlength="60"
        value="Polska"
        placeholder="Miasto lub kraj, np. Warszawa"
      />
      <ul class="pk-lb" id="pk-skad-lb" role="listbox" aria-label="Podpowiedzi miejsc startu" data-pk-lb2 hidden></ul>
    </div>

    <div class="nz-grupa">
      <label class="nz-legenda" for="pk-cel">Gdzie jedziesz?</label>
      <input
        class="nz-wejscie"
        id="pk-cel"
        name="cel"
        type="text"
        role="combobox"
        aria-expanded="false"
        aria-controls="pk-cel-lb"
        aria-autocomplete="list"
        aria-describedby="pk-cel-info"
        autocomplete="off"
        autocapitalize="off"
        spellcheck="false"
        maxlength="60"
        placeholder="Miasto lub kraj, np. Barcelona"
      />
      <ul class="pk-lb" id="pk-cel-lb" role="listbox" aria-label="Podpowiedzi miejsc" data-pk-lb hidden></ul>
    </div>

    <fieldset class="nz-grupa">
      <legend class="nz-legenda">Kiedy</legend>
      <div class="pk-daty">
        <label class="nz-pole">
          <span class="nz-etykieta">Od</span>
          <input class="nz-wejscie" type="date" name="od" />
        </label>
        <label class="nz-pole">
          <span class="nz-etykieta">Do</span>
          <input class="nz-wejscie" type="date" name="do" />
        </label>
      </div>
      <div class="pk-dni">
        <input class="nz-suwak" id="pk-dni" type="range" name="dni" min="1" max="30" step="1" value={DOM.dni} aria-label="Liczba dni" aria-describedby="pk-dni-opis" />
        <input class="nz-wejscie pk-dni__liczba" type="number" name="dni_liczba" min="1" max="30" step="1" inputmode="numeric" value={DOM.dni} aria-label="Liczba dni (pole liczby)" />
      </div>
      <p class="nz-pomoc" id="pk-dni-opis" data-pk-dni-opis>Dni liczą się z dat. Możesz też wpisać liczbę dni (1–30) bez dat.</p>
    </fieldset>

    <div class="nz-grupa nz-grupa--szeroka pk-klimat">
      <div class="pk-klimat__wiersz">
        <p class="pk-klimat__info" id="pk-cel-info" data-pk-klimat-info aria-live="polite">Wpisz cel i daty, a klimat wybierze się sam. Możesz też wybrać go ręcznie.</p>
        <button class="guzik guzik--obrys" type="button" data-pk-zmien aria-expanded="true" hidden>Zmień</button>
      </div>
      <p class="pk-klimat__info pk-trasa" data-pk-trasa aria-live="polite" hidden></p>
      <fieldset class="nz-grupa" data-pk-klimat>
        <legend class="nz-legenda">Klimat na miejscu</legend>
        <div class="nz-wybory">
          {
            KLIMAT.map(([w, n]) => (
              <label class="nz-wybor">
                <input type="radio" name="klimat" value={w} checked={w === DOM.klimat} />
                <span>{n}</span>
              </label>
            ))
          }
        </div>
      </fieldset>
    </div>

    <fieldset class="nz-grupa nz-grupa--szeroka">
      <legend class="nz-legenda">Kto jedzie</legend>
      <div class="nz-wybory">
        {
          KTO.map(([w, n]) => (
            <label class="nz-wybor">
              <input type="radio" name="sklad" value={w} checked={w === DOM.sklad} />
              <span>{n}</span>
            </label>
          ))
        }
      </div>
    </fieldset>

    <fieldset class="nz-grupa" data-pk-para>
      <legend class="nz-legenda">Para</legend>
      <div class="nz-wybory">
        {
          PARA.map(([w, n]) => (
            <label class="nz-wybor">
              <input type="radio" name="para" value={w} checked={w === DOM.para} />
              <span>{n}</span>
            </label>
          ))
        }
      </div>
    </fieldset>

    <fieldset class="nz-grupa" data-pk-rodzic hidden>
      <legend class="nz-legenda">Dorosły</legend>
      <div class="nz-wybory">
        {
          RODZIC.map(([w, n]) => (
            <label class="nz-wybor">
              <input type="radio" name="rodzic" value={w} checked={w === DOM.rodzic} />
              <span>{n}</span>
            </label>
          ))
        }
      </div>
    </fieldset>

    <fieldset class="nz-grupa nz-grupa--szeroka" data-pk-dzieci hidden>
      <legend class="nz-legenda">Dzieci</legend>
      <div class="pk-dzieci">
        <div class="nz-wybory" role="radiogroup" aria-label="Liczba dzieci">
          {
            [1, 2, 3, 4].map((n) => (
              <label class="nz-wybor nz-wybor--kwadrat">
                <input type="radio" name="dzieci" value={String(n)} checked={String(n) === DOM.dzieci} />
                <span>{n}</span>
              </label>
            ))
          }
        </div>
        <div class="pk-wieki">
          {
            [1, 2, 3, 4].map((n) => (
              <label class="nz-pole" data-pk-wiek={n} hidden={n > 1}>
                <span class="nz-etykieta">Wiek dziecka {n}</span>
                <select class="nz-wejscie" name={`wiek${n}`}>
                  {WIEK.map(([w, opis]) => <option value={w} selected={w === 'dziecko'}>{opis}</option>)}
                </select>
              </label>
            ))
          }
        </div>
      </div>
    </fieldset>

    <fieldset class="nz-grupa nz-grupa--szeroka">
      <legend class="nz-legenda">Co będziesz robić</legend>
      <div class="nz-wybory">
        {
          AKT.map(([w, n]) => (
            <label class="nz-wybor">
              <input type="checkbox" name="akt" value={w} checked={w === DOM.akt} />
              <span>{n}</span>
            </label>
          ))
        }
      </div>
    </fieldset>

    <fieldset class="nz-grupa">
      <legend class="nz-legenda">Transport</legend>
      <div class="nz-wybory">
        {
          TRANSPORT.map(([w, n]) => (
            <label class="nz-wybor">
              <input type="radio" name="transport" value={w} checked={w === DOM.transport} />
              <span>{n}</span>
            </label>
          ))
        }
      </div>
      <label class="nz-zaznacz">
        <input type="checkbox" name="wynajem" value="1" />
        <span>Wypożyczę auto na miejscu</span>
      </label>
    </fieldset>

    <div class="nz-grupa">
      <span class="nz-legenda">Bagaż</span>
      <label class="nz-zaznacz">
        <input type="checkbox" name="podreczny" value="1" />
        <span>Tylko bagaż podręczny</span>
      </label>
    </div>

    <div class="nz-grupa nz-grupa--szeroka nz-akcje">
      <button class="guzik guzik--twardy" type="submit">Pokaż listę</button>
      <p class="nz-pomoc">Lista zmienia się od razu po każdej zmianie wyboru.</p>
    </div>
  </form>

  <p class="nz-pomoc pk-zrodlo">Dane pogodowe: <a href="https://open-meteo.com/" rel="noopener">Open-Meteo.com</a> (<a href="https://creativecommons.org/licenses/by/4.0/" rel="noopener">CC BY 4.0</a>). Zmiany: średnie miesięczne z lat 2023–2025 policzyliśmy sami z danych Open-Meteo.</p>

  <noscript>
    <p class="nz-bez-js">Lista potrzebuje włączonego JavaScriptu. Włącz go w przeglądarce i odśwież stronę.</p>
  </noscript>

  <section class="pk-lista" aria-labelledby="pk-tytul" data-pk-lista tabindex="-1">
    <div class="pk-glowa">
      <div>
        <h2 id="pk-tytul" class="pk-tytul">Lista do spakowania</h2>
        <p class="pk-opis" data-pk-opis></p>
        <p class="pk-opis pk-zd" data-pk-zd></p>
        <p class="pk-data-druku" data-pk-data></p>
      </div>
      <div class="pk-postep">
        <p class="pk-postep__napis" data-pk-licznik aria-live="polite">Spakowane 0 z 0</p>
        <div class="pk-postep__tor" aria-hidden="true"><div class="pk-postep__pasek" data-pk-pasek></div></div>
      </div>
      <div class="pk-akcje">
        <button class="guzik guzik--twardy" type="button" data-pk-zapisz>Zapisz na komputer</button>
        <button class="guzik guzik--obrys" type="button" data-pk-wgraj>Wgraj listę</button>
        <button class="guzik guzik--obrys" type="button" data-pk-drukuj>Drukuj listę</button>
        <button class="guzik guzik--obrys" type="button" data-pk-kopiuj>Kopiuj listę</button>
        <input class="pk-plik" type="file" accept=".txt,.json,text/plain,application/json" data-pk-plik tabindex="-1" aria-hidden="true" hidden />
        <span class="pk-akcje__stan" role="status" data-pk-stan></span>
        <p class="nz-pomoc pk-akcje__pomoc">
          Plik .txt zawiera listę i dane pomocnika, więc możesz go później wgrać i dalej edytować. Drukowanie pozwala też zapisać listę jako PDF.
        </p>
      </div>
    </div>

    <div class="pk-kategorie">
      {
        kategorie.map((k) => (
          <section class="pk-kat" data-pk-kat={k.id} aria-labelledby={`pk-k-${k.id}`} hidden>
            <h3 class="pk-kat__tytul" id={`pk-k-${k.id}`}>
              <span data-pk-nazwa>{k.nazwa}</span> <span class="pk-kat__ile" data-pk-ile></span>
            </h3>
            <ul class="pk-kat__lista">
              {k.pozycje.map((p) => (
                <li
                  class="pk-poz"
                  data-pk-p={p.id}
                  data-k={lista(p.kto)}
                  data-kl={lista(p.klimat)}
                  data-a={lista(p.aktywnosci)}
                  data-tr={lista(p.transport)}
                  data-s={lista(p.sklad)}
                  data-md={p.min_dni}
                  data-mdp={p.min_dni_podreczny}
                  data-pb={p.podreczny}
                  data-mp={p.max_podreczny}
                  data-il={p.ilosc === '1' ? undefined : p.ilosc}
                  data-os={p.os ? '' : undefined}
                  data-dz={p.deszcz ? '' : undefined}
                  data-j={p.jedn}
                  data-t={p.trasa}
                  data-wr={p.warianty ? JSON.stringify(p.warianty) : undefined}
                  data-ba={lista(p.bez_akt)}
                  data-nc={p.noc ? p.noc[0] : undefined}
                  data-pl={p.plyn ? '' : undefined}
                  data-us={p.uwaga_samolot}
                  hidden
                >
                  <div class="pk-poz__wiersz">
                    <label class="pk-poz__et">
                      <input type="checkbox" />
                      <span class="pk-poz__nazwa">{p.nazwa}</span>
                    </label>
                    <input class="nz-wejscie pk-q" type="number" min="1" max="99" inputmode="numeric" aria-label={`Ilość: ${p.nazwa}`} />
                    <span class="pk-poz__jed" data-pk-jed />
                    <span class="pk-poz__ile" data-pk-ilosc />
                    <button class="pk-poz__usun" type="button" aria-label={`Usuń: ${p.nazwa}`}>Usuń</button>
                  </div>
                  {(p.uwaga || p.warianty || p.plyn || p.uwaga_samolot) && (
                    <p class="pk-poz__uwaga" hidden={!p.uwaga}>
                      <span data-pk-uw>{p.uwaga}</span>
                      {p.link && (
                        <>
                          {' '}
                          <a href="https://www.gov.pl/web/dyplomacja/informacje-dla-podrozujacych" rel="noopener" data-pk-gov>
                            Informacje dla podróżujących (gov.pl)
                          </a>
                        </>
                      )}
                      {p.kalk && (
                        <>
                          {' '}
                          <a href="/zdrowie/szczepienia-przed-wyjazdem/">Kalkulator szczepień przed wyjazdem</a>
                        </>
                      )}
                      {p.blog && POKAZ_LINK_MPJ && (
                        <>
                          {' '}
                          <a href={BLOG_MPJ} data-pk-blog hidden>
                            Jak zdobyć międzynarodowe prawo jazdy
                          </a>
                        </>
                      )}
                    </p>
                  )}
                </li>
              ))}
            </ul>
            <form class="pk-dodaj" data-pk-dodaj={k.id}>
              <input class="nz-wejscie" name="n" type="text" maxlength="60" autocomplete="off" placeholder="Dodaj własną rzecz" aria-label={`Dodaj własną rzecz do: ${k.nazwa}`} />
              <input class="nz-wejscie pk-dodaj__q" name="q" type="number" min="1" max="99" inputmode="numeric" placeholder="Ile" aria-label="Ilość własnej rzeczy" />
              <button class="guzik guzik--obrys" type="submit">Dodaj</button>
            </form>
            {'link' in k && k.link && (
              <p class="pk-kat__link">
                Więcej: <a href={k.link}>apteczka podróżnika, co spakować i o co zapytać farmaceutę</a>
              </p>
            )}
          </section>
        ))
      }
    </div>
    <p class="pk-usuniete" data-pk-usuniete hidden>
      <button class="guzik guzik--obrys" type="button" data-pk-przywroc>Przywróć usunięte</button>
    </p>
    <template data-pk-szablon>
      <li class="pk-poz" data-pk-p="" data-wl="" hidden>
        <div class="pk-poz__wiersz">
          <label class="pk-poz__et">
            <input type="checkbox" />
            <span class="pk-poz__nazwa"></span>
          </label>
          <input class="nz-wejscie pk-q" type="number" min="1" max="99" inputmode="numeric" />
          <span class="pk-poz__jed" data-pk-jed></span>
          <span class="pk-poz__ile" data-pk-ilosc></span>
          <button class="pk-poz__usun" type="button">Usuń</button>
        </div>
      </li>
    </template>
  </section>
</div>

<script>
  // Pomocnik pakowania: skąd i dokąd + daty → klimat i reguły trasy, filtr pozycji z atrybutów data-*, ilości ze wzorów, edycja listy,
  // zapis i wgranie pliku, pamięć w localStorage. Bez bibliotek.
  const KLUCZ = 'ambasada-pakowanie';
  const ZN = '--- dane pomocnika (nie usuwaj tej części, pozwala wgrać listę z powrotem) ---';
  const MW = ['styczniu', 'lutym', 'marcu', 'kwietniu', 'maju', 'czerwcu', 'lipcu', 'sierpniu', 'wrześniu', 'październiku', 'listopadzie', 'grudniu'];
  const MG = ['stycznia', 'lutego', 'marca', 'kwietnia', 'maja', 'czerwca', 'lipca', 'sierpnia', 'września', 'października', 'listopada', 'grudnia'];
  const STARE: Record<string, string> = { plaza: 'plaza', miasto: 'zwiedzanie', gory: 'wedrowki', zima: 'narty', biznes: 'praca' };
  const root = document.querySelector<HTMLElement>('[data-pakowanie]');
  if (root) {
    const $ = <T extends Element = HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const f = $<HTMLFormElement>('[data-pk-form]');
    const el = f.elements as unknown as Record<string, RadioNodeList & HTMLInputElement>;
    const kat = [...root.querySelectorAll<HTMLElement>('[data-pk-kat]')];
    const lista = $('[data-pk-lista]');
    const stan = $('[data-pk-stan]');
    const odh = new Set<string>();
    type M = { n: string; k?: string; a?: string[]; t: number[]; d: number[]; tx?: number[]; tn?: number[]; c?: string };
    type S = { n: string; c: string };
    type Sz = { zg?: string; ryzyko_zg?: boolean; inne?: string[]; uwagi_szcz?: string[] };
    type Kr = { pj?: string; ue?: boolean; eog?: boolean; dowod?: boolean; ekuz?: boolean; waluta?: string; gniazdko?: string[]; kraj?: string; szcz?: Sz };
    type Tr = { a: string; b: string; pl: boolean; same: boolean; inny: boolean; tryb: string; dowod: boolean; ekuz: boolean; walInna: boolean; wb: string; gnInne: boolean; gb: string[]; pozaUE: boolean; daleko: boolean; mpj: boolean; auto: boolean; pj: string; nz: string[]; sz?: Sz; szT: string; w: Record<string, string> };
    const SPOL: S = { n: 'Polska', c: 'Polska' };
    let s: S | null = SPOL;
    type W = { id: string; k: string; n: string; q: number };
    let zapisuj = false;
    let m: M | null = null;
    let reczny = false;
    let otw = false;
    let w: W[] = [];
    let x: string[] = [];
    let ile: Record<string, number> = {};

    type Ust = { skad: string; s: S | null; cel: string; m: M | null; od: string; do: string; r: boolean; sklad: string; para: string; rodzic: string; dzieci: number; wiek: string[]; akt: string[]; klimat: string; dni: number; transport: string; podreczny: boolean; wyn: boolean };

    const dni = (v: unknown) => Math.min(30, Math.max(1, Math.round(Number(v)) || 1));
    const akt = () => [...f.querySelectorAll<HTMLInputElement>('input[name="akt"]')];
    const wiek = (n: number) => f.elements.namedItem('wiek' + n) as HTMLSelectElement;
    const czytaj = (): Ust => ({
      skad: el.skad.value.trim(),
      s,
      cel: el.cel.value.trim(),
      m,
      od: el.od.value,
      do: el.do.value,
      r: reczny,
      sklad: el.sklad.value,
      para: el.para.value,
      rodzic: el.rodzic.value,
      dzieci: Number(el.dzieci.value) || 1,
      wiek: [1, 2, 3, 4].map((n) => wiek(n).value),
      akt: akt().filter((c) => c.checked).map((c) => c.value),
      klimat: el.klimat.value,
      dni: dni(el.dni.value),
      transport: el.transport.value,
      podreczny: el.podreczny.checked,
      wyn: el.wynajem.checked,
    });
    const tx = (v: unknown, n = 60) => (typeof v === 'string' ? v.slice(0, n) : '');
    const dat = (v: unknown) => (typeof v === 'string' && /^\d{4}-\d\d-\d\d$/.test(v) ? v : '');
    const ustaw = (u: Ust & { typ?: string }) => {
      for (const k of ['sklad', 'para', 'rodzic', 'klimat', 'transport'] as const) if (u[k]) el[k].value = u[k];
      if (u.skad === undefined && !u.s) {
        el.skad.value = SPOL.n;
        s = SPOL;
      } else {
        el.skad.value = tx(u.skad);
        s = u.s && typeof u.s.n === 'string' && typeof u.s.c === 'string' && u.s.c ? { n: tx(u.s.n), c: tx(u.s.c) } : null;
      }
      el.cel.value = tx(u.cel);
      el.od.value = dat(u.od);
      el.do.value = dat(u.do);
      el.do.min = el.od.value;
      const mm = u.m;
      const t12 = (v: unknown) => (Array.isArray(v) && v.length === 12 ? v.map(Number) : undefined);
      m = mm && typeof mm.n === 'string' && t12(mm.t) && t12(mm.d) ? { n: tx(mm.n), k: tx(mm.k), t: t12(mm.t)!, d: t12(mm.d)!, tx: t12(mm.tx), tn: t12(mm.tn), c: tx(mm.c) || undefined } : null;
      reczny = otw = !!u.r;
      el.dzieci.value = String(Number(u.dzieci) || 1);
      (Array.isArray(u.wiek) ? u.wiek : []).forEach((v, i) => v && i < 4 && (wiek(i + 1).value = v));
      el.dni.value = el.dni_liczba.value = String(dni(u.dni));
      el.podreczny.checked = !!u.podreczny;
      el.wynajem.checked = !!u.wyn;
      const a = Array.isArray(u.akt) ? u.akt : u.typ && STARE[u.typ] ? [STARE[u.typ]] : [];
      akt().forEach((c) => (c.checked = a.includes(c.value)));
    };

    // ——— miejsca: podpowiedzi z klimat.json i dane krajów z kraje.json (obie z własnej domeny, po pierwszym dotknięciu pola) ———
    type E = M & { typ?: string };
    let baza: { e: E; h: string[] }[] | null = null;
    let pob: Promise<void> | null = null;
    let pobK: Promise<void> | null = null;
    let K: Record<string, Kr> | null = null;
    let blad = false;
    const norm = (s: string) => s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/ł/g, 'l').trim();
    const kc = (e: { typ?: string; n: string; k?: string }) => (e.typ === 'kraj' ? e.n : e.k || e.n);
    const ladujK = () =>
      (pobK ||= fetch('/dane/kraje.json')
        .then((r) => r.json())
        .then((j) => {
          K = j;
        })
        .catch(() => {
          pobK = null;
        })
        .then(() => generuj()));
    const laduj = () => {
      ladujK();
      return (pob ||= fetch('/dane/klimat.json')
        .then((r) => r.json())
        .then((j) => {
          baza = (j.m as E[]).map((e) => ({ e, h: [e.n, ...(e.a || []), e.k || ''].map(norm) }));
          if (m && (!m.c || !m.tx)) {
            const e = baza.find((b) => b.e.n === m!.n)?.e;
            m.c ||= kc(e || { n: m.n });
            if (e) (m.tx = e.tx), (m.tn = e.tn);
          }
          blad = false;
        })
        .catch(() => {
          blad = true;
          pob = null;
        })
        .then(() => {
          generuj();
          pokazAll();
        }));
    };
    const szukaj = (q0: string) => {
      const q = norm(q0);
      if (q.length < 2 || !baza) return [];
      const sc = (b: { h: string[] }) => (b.h[0].startsWith(q) ? 0 : b.h.slice(1, -1).some((y) => y.startsWith(q)) ? 1 : 2);
      return baza
        .filter((b) => b.h.some((y) => y.startsWith(q) || y.includes(' ' + q)))
        .sort((a, b) => sc(a) - sc(b))
        .slice(0, 8)
        .map((b) => b.e);
    };
    const kb: (() => void)[] = [];
    const pokazAll = () => kb.forEach((f) => f());
    const wybierz = (e: E) => {
      m = { n: e.n, k: e.k, t: e.t, d: e.d, tx: e.tx, tn: e.tn, c: kc(e) };
      el.cel.value = e.n;
      reczny = otw = false;
      zapisuj = true;
      pokazAll();
      generuj();
    };
    const wybierzSkad = (e: E) => {
      s = { n: e.n, c: kc(e) };
      el.skad.value = e.n;
      zapisuj = true;
      pokazAll();
      generuj();
    };
    // Autouzupełniacz (combobox): jedna implementacja dla pól „Skąd” i „Dokąd”.
    const kombi = (inp: HTMLInputElement, lb: HTMLElement, pre: string, wybrane: () => boolean, wyb: (e: E) => void) => {
      let wyn: E[] = [];
      let ak = -1;
      kb.push(() => {
        wyn = document.activeElement === inp && !wybrane() ? szukaj(inp.value) : [];
        ak = -1;
        lb.replaceChildren(
          ...wyn.map((e, i) => {
            const o = document.createElement('li');
            o.id = pre + i;
            o.setAttribute('role', 'option');
            o.textContent = e.typ === 'kraj' ? e.n + (e.k && e.k !== e.n ? ` (dane: ${e.k})` : '') : e.k ? `${e.n}, ${e.k}` : e.n;
            return o;
          }),
        );
        lb.hidden = !wyn.length;
        inp.setAttribute('aria-expanded', String(!lb.hidden));
        inp.removeAttribute('aria-activedescendant');
      });
      const ruch = (i: number) => {
        ak = (i + wyn.length) % wyn.length;
        [...lb.children].forEach((o, j) => o.setAttribute('aria-selected', String(j === ak)));
        inp.setAttribute('aria-activedescendant', pre + ak);
        lb.children[ak].scrollIntoView({ block: 'nearest' });
      };
      inp.addEventListener('focus', () => {
        laduj();
        pokazAll();
      });
      inp.addEventListener('blur', () => {
        lb.hidden = true;
        inp.setAttribute('aria-expanded', 'false');
      });
      inp.addEventListener('keydown', (e) => {
        const k = e.key;
        if (k === 'ArrowDown' && wyn.length) ruch(ak + 1);
        else if (k === 'ArrowUp' && wyn.length) ruch(ak < 0 ? -1 : ak - 1);
        else if (k === 'Enter' && ak >= 0) wyb(wyn[ak]);
        else if (k === 'Escape' && !lb.hidden) lb.hidden = true;
        else return;
        e.preventDefault();
      });
      lb.addEventListener('mousedown', (e) => {
        e.preventDefault();
        const i = [...lb.children].indexOf((e.target as Element).closest('li')!);
        if (i >= 0) wyb(wyn[i]);
      });
    };
    kombi(el.cel, $('[data-pk-lb]'), 'pk-o', () => !!m, wybierz);
    kombi(el.skad, $('[data-pk-lb2]'), 'pk-s', () => !!s, wybierzSkad);

    // ——— trasa: kraj startu → kraj celu (public/dane/kraje.json); null = trasa nieznana, lista bez zawężeń ———
    const trasa = (u: Ust): Tr | null => {
      if (!K || !m?.c || !s?.c) return null;
      const rozw = (c: string) => {
        const e = K![c];
        const r = e?.kraj && K![e.kraj] ? e.kraj : c;
        return { c: r, e: K![r] || null };
      };
      const A = rozw(s.c), B = rozw(m.c);
      const ue = (x: { c: string; e: Kr | null }) => !!(x.e && (x.e.ue || x.e.eog)) || x.c === 'Szwajcaria';
      const ea = A.e, eb = B.e;
      const same = A.c === B.c;
      const inny = !same;
      const aUE = ue(A), bUE = ue(B);
      const dowod = inny && aUE && (bUE || eb?.dowod === true);
      const pl = A.c === 'Polska';
      const tryb = !inny ? 'ten_kraj' : dowod ? (bUE ? 'dowod' : 'dowod_poza') : aUE ? 'paszport' : 'paszport_obcy';
      const ekuz = inny && ea?.ekuz === true && eb?.ekuz === true;
      const wa = ea?.waluta, wb = eb?.waluta || '';
      const walInna = inny && (!wa || !wb || wa !== wb);
      const ga = ea?.gniazdko || [], gb = eb?.gniazdko || [];
      const gnInne = inny && (!ga.length || !gb.length || !ga.some((t) => gb.includes(t)));
      const pj = eb?.pj || 'sprawdz';
      const auto = !!(u.transport === 'samochod' || u.wyn) && inny;
      const mpj = auto && (aUE ? pj !== 'pl' : true);
      // świadectwo szczepień (żółta gorączka) z kraje.json `szcz`: '' = bez pozycji, wszyscy | ryzyko (start z kraju z ryzykiem) | sprawdz (brak danych)
      const sz = eb?.szcz;
      const zr = ea?.szcz?.ryzyko_zg;
      const szT = !inny ? '' : !sz ? 'sprawdz' : sz.zg === 'wszyscy' ? 'wszyscy' : sz.zg !== 'z_ryzyka' || zr === false ? '' : zr ? 'ryzyko' : 'sprawdz';
      return {
        a: A.c, b: B.c, pl, same, inny, tryb, dowod, ekuz, walInna, wb, gnInne, gb,
        pozaUE: inny && !bUE, daleko: inny && !(aUE && bUE), mpj, auto, pj, sz, szT,
        nz: inny ? [...(ea ? [] : [A.c]), ...(eb ? [] : [B.c])] : [],
        w: {
          paszport: tryb,
          wiza: inny && !dowod && !pl ? 'obcy' : '',
          ubezpieczenie: inny && !ekuz ? 'bez_ekuz' : '',
          gotowka: walInna ? (wb ? 'waluta' : 'nieznana') : '',
          przejsciowka: gnInne ? (gb.length ? 'typ' : 'nieznane') : '',
          prawo_jazdy_mpj: pl ? pj : 'obcy',
          swiadectwo_szczepien: szT,
        },
      };
    };
    const warunek = (t: Tr, w: string) =>
      w === 'inny_kraj' ? t.inny : w === 'poza_dowod' ? t.inny && !t.dowod : w === 'ekuz' ? t.ekuz : w === 'inna_waluta' ? t.walInna : w === 'inne_gniazdko' ? t.gnInne : w === 'poza_ue' ? t.pozaUE : w === 'daleko' ? t.daleko : w === 'szcz' ? !!t.szT : w === 'mpj' ? t.mpj : true;
    const zdanieTrasy = (t: Tr) => {
      if (t.same) return `Podróż w obrębie kraju (${t.a}): paszport, EKUZ, adapter do gniazdek i wymiana waluty nie są potrzebne.`;
      const DOK: Record<string, string> = {
        dowod: 'dowód osobisty wystarczy',
        dowod_poza: 'dowód osobisty wystarczy (dla obywateli UE; sprawdź dla swojego obywatelstwa)',
        paszport: 'paszport (sprawdź wizę)',
        paszport_obcy: 'paszport, sprawdź wizę i zasady wjazdu dla swojego obywatelstwa',
      };
      const nz = t.nz.length ? `Nie znam szczegółów wjazdu dla: ${t.nz.join(', ')}. ${t.pl ? 'Sprawdź gov.pl.' : 'Sprawdź w konsulacie.'} ` : '';
      const pjz = !t.auto ? '' : !t.mpj ? `, prawo jazdy: ${t.pl ? 'polskie' : 'krajowe'} wystarczy` : !t.pl ? ', prawo jazdy: sprawdź dla swojego kraju' : t.pj === 'sprawdz' ? ', prawo jazdy: sprawdź, czy potrzebne MPJ' : `, prawo jazdy: potrzebne MPJ (wzór ${t.pj === 'mpj1949' ? 1949 : 1968})`;
      const sz = t.sz;
      const ZG = 'Świadectwo szczepień przeciw żółtej gorączce: ';
      const szz = !sz
        ? 'Świadectwo szczepień: sprawdź w kalkulatorze szczepień.'
        : (t.szT === 'wszyscy'
            ? ZG + 'wymagane od wszystkich przybywających.'
            : t.szT === 'ryzyko'
              ? ZG + 'wymagane (przylot z kraju z ryzykiem żółtej gorączki).'
              : sz.zg !== 'z_ryzyka'
                ? 'Świadectwo szczepień: niewymagane.'
                : t.szT
                  ? ZG + 'wymagane przy przylocie z kraju z ryzykiem żółtej gorączki; sprawdź w kalkulatorze szczepień.'
                  : ZG + `niewymagane przy bezpośrednim przylocie (start: ${t.a}); przy przesiadce ponad 12 h w kraju z ryzykiem żółtej gorączki wymagane.`) +
          (sz.ryzyko_zg ? ' W kraju jest ryzyko żółtej gorączki: o szczepienie zapytaj lekarza medycyny podróży.' : '') +
          (sz.inne?.length ? ` Wymagane też: ${sz.inne.join(', ')}.` : '') +
          (sz.uwagi_szcz?.length ? ` Uwagi: ${sz.uwagi_szcz.join('; ').replace(/\.?$/, '.')}` : '');
      return `${nz}${t.a} → ${t.b}: ${DOK[t.tryb]}, ${t.ekuz ? 'EKUZ działa' : 'bez EKUZ'}, ${t.walInna ? (t.wb ? 'waluta ' + t.wb : 'waluta nieznana') : 'ta sama waluta'}, ${t.gnInne ? (t.gb.length ? 'adapter typu ' + t.gb.join('/') : 'adapter (typ gniazdek nieznany)') : 'gniazdka pasują'}${pjz}. ${szz}`;
    };
    // nazwa i uwaga pozycji zależne od trasy (data-wr); link gov.pl tylko przy starcie z Polski
    type V = { n?: string; u?: string; l?: boolean; b?: boolean; k?: string };
    const wariant = (p: HTMLLIElement, t: Tr | null, v: V | undefined, dop: string) => {
      const ne = p.querySelector('.pk-poz__nazwa')!;
      const ue = p.querySelector('[data-pk-uw]');
      p.dataset.n0 ??= ne.textContent!;
      p.dataset.u0 ??= ue?.textContent ?? '';
      const n = v?.n ? v.n.replace('{w}', t!.wb).replace('{g}', t!.gb.join('/')) : p.dataset.n0;
      ne.textContent = n;
      p.querySelector('.pk-q')!.setAttribute('aria-label', 'Ilość: ' + n);
      p.querySelector('.pk-poz__usun')!.setAttribute('aria-label', 'Usuń: ' + n);
      const u = ((v?.u ?? p.dataset.u0) + dop).trim();
      if (ue) {
        ue.textContent = u;
        (ue.parentElement as HTMLElement).hidden = !u;
      }
      const a = p.querySelector<HTMLElement>('[data-pk-gov]');
      if (a) a.hidden = !((v ? v.l : true) && (!t || t.pl));
      const bl = p.querySelector<HTMLElement>('[data-pk-blog]');
      if (bl) bl.hidden = !v?.b;
    };

    // ——— daty i klimat ———
    const okres = (od: string, dk: string) => {
      const A = Date.parse(od), B = Date.parse(dk);
      return A && B && B >= A ? { A, B, n: Math.max(1, Math.round((B - A) / 864e5)) } : null;
    };
    const iso = (t: number) => new Date(t).toISOString().slice(0, 10);
    const zakres = (od: string, dk: string) => {
      const o = new Intl.DateTimeFormat('pl-PL', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
      const A = new Date(od), B = new Date(dk);
      return o.formatRange ? o.formatRange(A, B) : o.format(A) + ' – ' + o.format(B);
    };
    const dniTxt = (n: number) => (n === 1 ? '1 dzień' : `${n} dni`);
    const pogoda = (p: { A: number; B: number; n: number }, mi: M) => {
      let T = 0, D = 0, X = 0, N = 0;
      const lim = Math.min(p.n, 366);
      const dn = !!(mi.tx && mi.tn);
      for (let i = 0; i < lim; i++) {
        const mo = new Date(p.A + i * 864e5).getUTCMonth();
        T += mi.t[mo] / lim;
        D += mi.d[mo] / lim;
        if (dn) (X += mi.tx![mo] / lim), (N += mi.tn![mo] / lim);
      }
      T = Math.round(T);
      X = Math.round(X);
      N = Math.round(N);
      const s = T >= 26 ? 'gorąco' : T >= 18 ? 'ciepło' : T >= 10 ? 'umiarkowanie' : T >= 0 ? 'zimno' : 'mróz';
      const a = new Date(p.A).getUTCMonth(), b = new Date(p.B).getUTCMonth();
      return {
        klimat: T >= 18 ? 'cieplo' : T >= 10 ? 'umiarkowanie' : 'zimno',
        deszcz: D >= 10,
        noc: dn ? N : null,
        zdanie: `${mi.n} ${a === b ? 'w ' + MW[a] : `od ${MG[a]} do ${MG[b]}`}: ${dn ? `w dzień ok. ${X} °C, w nocy ok. ${N} °C` : `ok. ${T} °C, ${s}`}, ${D >= 10 ? 'często pada' : D >= 5 ? 'czasem deszcz' : 'mało deszczu'}.`,
      };
    };

    // ——— ilości: mały parser wzorów zamiast eval ———
    const FN: Record<string, (...a: number[]) => number> = { min: Math.min, max: Math.max, ceil: Math.ceil };
    const licz = (wz: string, v: Record<string, number>) => {
      const t = wz.match(/\d+|[a-z_]+|[-+*/(),]/g) || [];
      let i = 0;
      const wyr = (): number => {
        let a = skl();
        while (t[i] === '+' || t[i] === '-') a = t[i++] === '+' ? a + skl() : a - skl();
        return a;
      };
      const skl = (): number => {
        let a = czy();
        while (t[i] === '*' || t[i] === '/') a = t[i++] === '*' ? a * czy() : a / czy();
        return a;
      };
      const czy = (): number => {
        const y = t[i++];
        if (y === '(') { const a = wyr(); i++; return a; }
        if (/^\d/.test(y)) return +y;
        if (t[i] === '(' && FN[y]) {
          i++;
          const r = [wyr()];
          while (t[i] === ',') { i++; r.push(wyr()); }
          i++;
          return FN[y](...r);
        }
        return v[y] || 0;
      };
      return wyr();
    };

    const PARY: Record<string, string[]> = { km: ['kobieta', 'mezczyzna'], kk: ['kobieta', 'kobieta'], mm: ['mezczyzna', 'mezczyzna'] };
    const zDziecmi = (u: Ust) => u.sklad === 'para_dzieci' || u.sklad === 'sam_dzieci';
    const osoby = (u: Ust) => {
      const dorosli = u.sklad === 'kobieta' || u.sklad === 'mezczyzna' ? [u.sklad] : u.sklad === 'sam_dzieci' ? [u.rodzic] : PARY[u.para] || PARY.km;
      return dorosli.concat(zDziecmi(u) ? u.wiek.slice(0, u.dzieci) : []);
    };

    const napis = (n: string) => (f.querySelector(`input[name="${n}"]:checked + span`)?.textContent || '').trim().toLowerCase();
    const opis = (u: Ust) => {
      const d = u.dzieci;
      const ilu = `z ${d} ${d === 1 ? 'dzieckiem' : 'dziećmi'}`;
      const WIEK: Record<string, string> = { niemowle: 'niemowlę', dziecko: '3–12 lat', nastolatek: 'nastolatek' };
      const wieki = zDziecmi(u) ? ` (${u.wiek.slice(0, d).map((v) => WIEK[v]).join(', ')})` : '';
      const kto =
        u.sklad === 'para'
          ? 'Para' + (u.para === 'km' ? '' : ` (${napis('para')})`)
          : u.sklad === 'para_dzieci'
            ? `Para ${ilu}${wieki}`
            : u.sklad === 'sam_dzieci'
              ? `${napis('rodzic')} ${ilu}${wieki}`.replace(/^./, (c) => c.toUpperCase())
              : napis('sklad').replace(/^./, (c) => c.toUpperCase());
      const p = okres(u.od, u.do);
      return [
        u.cel ? (u.skad ? `${u.skad} → ${u.cel}` : u.cel) : '',
        p ? `${zakres(u.od, u.do)} (${dniTxt(p.n)})` : dniTxt(u.dni),
        kto,
        ...[...f.querySelectorAll('input[name="akt"]:checked + span')].map((s) => s.textContent!.trim().toLowerCase()),
        napis('klimat'),
        napis('transport'),
        u.wyn ? 'auto na miejscu' : '',
        u.podreczny ? 'tylko bagaż podręczny' : '',
      ]
        .filter(Boolean)
        .join(', ');
    };

    const dane = () => ({ v: 2, u: czytaj(), o: [...odh], w, x, i: ile, d: Date.now() });
    const zapisz = () => {
      if (!zapisuj) return;
      try {
        localStorage.setItem(KLUCZ, JSON.stringify(dane()));
      } catch {
        /* pamięć wyłączona albo pełna: lista działa bez zapisu */
      }
    };

    const licznik = () => {
      let wszystkie = 0, spakowane = 0;
      for (const k of kat) {
        if (k.hidden) continue;
        const l = [...k.querySelectorAll<HTMLLIElement>('[data-pk-p]:not([hidden])')];
        const z = l.filter((p) => odh.has(p.dataset.pkP!)).length;
        wszystkie += l.length;
        spakowane += z;
        k.querySelector('[data-pk-ile]')!.textContent = `${z}/${l.length}`;
      }
      $('[data-pk-licznik]').textContent = `Spakowane ${spakowane} z ${wszystkie}`;
      $('[data-pk-pasek]').style.transform = `scaleX(${wszystkie ? spakowane / wszystkie : 0})`;
    };

    // własne pozycje: render z szablonu do list kategorii
    const szablon = $<HTMLTemplateElement>('[data-pk-szablon]').content.firstElementChild!;
    const renderW = () => {
      root.querySelectorAll('[data-wl]').forEach((n) => n.remove());
      for (const o of w) {
        const ul = root.querySelector(`[data-pk-kat="${o.k}"] .pk-kat__lista`);
        if (!ul) continue;
        const li = szablon.cloneNode(true) as HTMLLIElement;
        li.dataset.pkP = o.id;
        li.dataset.il = String(o.q);
        li.querySelector('.pk-poz__nazwa')!.textContent = o.n;
        li.querySelector('.pk-q')!.setAttribute('aria-label', 'Ilość: ' + o.n);
        li.querySelector('.pk-poz__usun')!.setAttribute('aria-label', 'Usuń: ' + o.n);
        ul.append(li);
      }
    };

    const generuj = () => {
      // klimat z celu i dat
      const per = okres(el.od.value, el.do.value);
      const pg = m && per ? pogoda(per, m) : null;
      if (pg && !reczny) el.klimat.value = pg.klimat;
      const u = czytaj();
      const tr = trasa(u);
      const ludzie = osoby(u);
      const klimat = u.akt.includes('narty') ? 'zimno' : u.klimat;
      const deszcz = !!pg?.deszcz;
      const jest = (a: string | undefined, v: string) => !a || a.split(' ').includes(v);
      const info = !pg
        ? m
          ? `${m.n}: wybierz daty wyjazdu, a klimat dobierze się sam.`
          : blad
            ? 'Nie udało się pobrać listy miejsc. Wybierz klimat ręcznie.'
            : u.cel.length > 1 && baza && !szukaj(u.cel).length
              ? 'Nie znam tego miejsca, wybierz klimat ręcznie.'
              : 'Wpisz cel i daty, a klimat wybierze się sam. Możesz też wybrać go ręcznie.'
        : pg.zdanie + (reczny ? ` Ręcznie wybrano: ${napis('klimat')}.` : '');
      $('[data-pk-klimat-info]').textContent = info;
      const zt = $('[data-pk-trasa]');
      zt.textContent = tr ? zdanieTrasy(tr) : '';
      zt.hidden = !tr;
      $('[data-pk-zd]').textContent = [pg ? info : '', zt.textContent].filter(Boolean).join(' ');
      const zm = $<HTMLButtonElement>('[data-pk-zmien]');
      zm.hidden = !pg;
      zm.setAttribute('aria-expanded', String(!pg || otw));
      $('[data-pk-klimat]').hidden = !!pg && !otw;
      $('[data-pk-dni-opis]').textContent = per && per.n > 30 ? 'Pobyt trwa dłużej niż 30 dni, lista liczy 30 dni i zakłada pranie.' : 'Dni liczą się z dat. Możesz też wpisać liczbę dni (1–30) bez dat.';

      $('[data-pk-para]').hidden = !(u.sklad === 'para' || u.sklad === 'para_dzieci');
      $('[data-pk-rodzic]').hidden = u.sklad !== 'sam_dzieci';
      $('[data-pk-dzieci]').hidden = !zDziecmi(u);
      root.querySelectorAll<HTMLElement>('[data-pk-wiek]').forEach((v) => (v.hidden = Number(v.dataset.pkWiek) > u.dzieci));

      const widoczne = new Set<string>();
      const noc = pg?.noc;
      const zimnaNoc = noc != null && noc < 10;
      const lot = u.transport === 'samolot';
      const DZ = ['niemowle', 'dziecko', 'nastolatek'];
      const odm = (j: string, n: number) => (j !== 'par' ? j : n === 1 ? 'para' : n % 10 > 1 && n % 10 < 5 && (n % 100 < 10 || n % 100 > 20) ? 'pary' : 'par');
      for (const p of root.querySelectorAll<HTMLLIElement>('[data-pk-p]')) {
        const d = p.dataset;
        const id = d.pkP!;
        const v: V | undefined = d.wr && tr ? JSON.parse(d.wr)[tr.w[id]] : undefined;
        const kk = v?.k || d.k;
        const pasujace = kk ? ludzie.filter((o) => kk.split(' ').includes(o)) : ludzie;
        const prog = Number((u.podreczny && d.mdp) || d.md || 1);
        const ok =
          !x.includes(id) &&
          pasujace.length > 0 &&
          jest(d.kl, klimat) &&
          (!d.a || d.a.split(' ').some((v) => u.akt.includes(v))) &&
          (d.dz === undefined || deszcz) &&
          (!d.ba || !d.ba.split(' ').some((v) => u.akt.includes(v))) &&
          (!d.nc || (d.nc === 'z' ? zimnaNoc : !zimnaNoc)) &&
          (jest(d.tr, u.transport) || (u.wyn && !!d.tr?.split(' ').includes('wynajem'))) &&
          jest(d.s, u.sklad) &&
          (!d.t || (tr ? warunek(tr, d.t) : d.t !== 'mpj' && d.t !== 'szcz')) &&
          u.dni >= prog &&
          !(d.pb === 'bez' && u.podreczny) &&
          !(d.pb === 'tylko' && !u.podreczny);
        p.hidden = !ok;
        if (!ok) continue;
        widoczne.add(id);
        const dop = (lot && d.us ? ' ' + d.us : '') + (lot && u.podreczny && d.pl !== undefined ? ' W bagażu podręcznym: opakowanie do 100 ml, w woreczku strunowym.' : '');
        if (d.wr || d.us || d.pl !== undefined) wariant(p, tr, v, dop);
        const n = d.os !== undefined ? pasujace.length : 1;
        const dzieci = pasujace.filter((o) => DZ.includes(o)).length;
        let q = Math.max(1, Math.round(licz(d.il || '1', { dni: u.dni, na_osobe: pasujace.length, na_dziecko: dzieci })));
        if (u.podreczny && d.mp) q = Math.min(q, Number(d.mp));
        const j = d.j || 'szt.';
        const razem = ile[id] || q * n;
        // „8 szt., po 4 na osobę” (Piotr 2026-11-18: bez „2 × 4”); same dzieci → „na dziecko”
        const po = !ile[id] && n > 1 ? `, po ${q} na ${dzieci === n ? 'dziecko' : 'osobę'}` : '';
        const jr = odm(j, razem);
        p.querySelector<HTMLInputElement>('.pk-q')!.value = String(razem);
        p.querySelector('[data-pk-jed]')!.textContent = j === 'szt.' && !po ? '' : jr + po;
        p.querySelector('[data-pk-ilosc]')!.textContent = razem < 2 ? '' : `${razem} ${jr}${po}`;
        p.querySelector('input')!.checked = odh.has(id);
      }
      for (const id of [...odh]) if (!widoczne.has(id)) odh.delete(id);
      for (const k of kat) k.hidden = !k.querySelector('[data-pk-p]:not([hidden])');
      $('[data-pk-usuniete]').hidden = !x.length;
      $('[data-pk-przywroc]').textContent = `Przywróć usunięte (${x.length})`;
      $('[data-pk-opis]').textContent = opis(u);
      $('[data-pk-data]').textContent = 'Lista z dnia ' + new Date().toLocaleDateString('pl-PL', { day: 'numeric', month: 'long', year: 'numeric' });
      licznik();
      zapisz();
    };

    // ——— zdarzenia formularza ———
    f.addEventListener('input', (e) => {
      const t = e.target as HTMLInputElement;
      const nm = t.name;
      if (nm === 'cel') {
        laduj();
        if (m && t.value !== m.n) m = null;
        reczny = otw = false;
        pokazAll();
      }
      if (nm === 'skad') {
        laduj();
        if (s && t.value !== s.n) s = null;
        pokazAll();
      }
      if (nm === 'od' || nm === 'do') {
        reczny = otw = false;
        el.do.min = el.od.value;
        if (el.od.value && el.do.value && el.do.value < el.od.value) el.do.value = el.od.value;
        const p = okres(el.od.value, el.do.value);
        if (p) el.dni.value = el.dni_liczba.value = String(dni(p.n));
      }
      if (nm === 'dni_liczba') {
        if (t.value === '') return;
        el.dni.value = String(dni(t.value));
      }
      if (nm === 'dni' || nm === 'dni_liczba') {
        el.dni_liczba.value = el.dni.value;
        const A = Date.parse(el.od.value);
        if (A) el.do.value = iso(A + dni(el.dni.value) * 864e5);
      }
      if (nm === 'klimat') reczny = otw = true;
      zapisuj = true;
      generuj();
    });
    f.addEventListener('change', (e) => {
      const t = e.target as HTMLInputElement;
      if (t.name === 'dni_liczba') t.value = el.dni.value;
      if (t.name === 'cel' && !m && baza) {
        const q = norm(t.value);
        const b = q && baza.find((y) => y.h.slice(0, -1).includes(q));
        if (b) wybierz(b.e);
      }
      if (t.name === 'skad') {
        const q = norm(t.value);
        if (!q) {
          s = SPOL;
          t.value = SPOL.n;
          zapisuj = true;
          generuj();
        } else if (!s && baza) {
          const b = baza.find((y) => y.h.slice(0, -1).includes(q));
          if (b) wybierzSkad(b.e);
        }
      }
    });
    f.addEventListener('submit', (e) => {
      e.preventDefault();
      zapisuj = true;
      generuj();
      lista.focus();
    });
    $('[data-pk-zmien]').addEventListener('click', () => {
      otw = !otw;
      generuj();
    });

    // ——— edycja listy: odhaczanie, ilość, usuwanie, własne rzeczy ———
    const idPoz = (t: Element) => t.closest<HTMLElement>('[data-pk-p]')?.dataset.pkP;
    lista.addEventListener('change', (e) => {
      const t = e.target as HTMLInputElement;
      const id = idPoz(t);
      if (!id) return;
      if (t.classList.contains('pk-q')) {
        const v = Math.round(Number(t.value));
        v >= 1 && v <= 99 ? (ile[id] = v) : delete ile[id];
        zapisuj = true;
        generuj();
        return;
      }
      t.checked ? odh.add(id) : odh.delete(id);
      zapisuj = true;
      licznik();
      zapisz();
    });
    lista.addEventListener('click', (e) => {
      const b = (e.target as Element).closest('.pk-poz__usun');
      if (!b) return;
      const li = b.closest<HTMLLIElement>('[data-pk-p]')!;
      const id = li.dataset.pkP!;
      const sas = (s: 'nextElementSibling' | 'previousElementSibling') => {
        let y = li[s] as HTMLElement | null;
        while (y && y.hidden) y = y[s] as HTMLElement | null;
        return y;
      };
      const kolejny = (sas('nextElementSibling') || sas('previousElementSibling'))?.dataset.pkP;
      const dodaj = li.closest('[data-pk-kat]')!.querySelector<HTMLInputElement>('.pk-dodaj input')!;
      if (li.hasAttribute('data-wl')) {
        w = w.filter((o) => o.id !== id);
        delete ile[id];
        renderW();
      } else x.push(id);
      odh.delete(id);
      zapisuj = true;
      generuj();
      (kolejny ? root.querySelector<HTMLInputElement>(`[data-pk-p="${kolejny}"] input`) : dodaj.closest<HTMLElement>('[data-pk-kat]')!.hidden ? lista : dodaj)?.focus();
    });
    lista.addEventListener('submit', (e) => {
      const fm = e.target as HTMLFormElement;
      if (!fm.dataset.pkDodaj) return;
      e.preventDefault();
      const fd = new FormData(fm);
      const nm = String(fd.get('n')).trim().slice(0, 60);
      if (!nm) return;
      const id = 'wl-' + (Math.max(0, ...w.map((o) => Number(o.id.slice(3)))) + 1);
      w.push({ id, k: fm.dataset.pkDodaj, n: nm, q: Math.min(99, Math.max(1, Math.round(Number(fd.get('q'))) || 1)) });
      fm.reset();
      renderW();
      zapisuj = true;
      generuj();
      fm.querySelector('input')!.focus();
    });
    $('[data-pk-przywroc]').addEventListener('click', () => {
      x = [];
      zapisuj = true;
      generuj();
    });

    // ——— druk, kopiowanie, zapis i wgranie pliku ———
    $('[data-pk-drukuj]').addEventListener('click', () => window.print());
    const tekst = () => {
      const wiersze = ['Lista do spakowania: ' + $('[data-pk-opis]').textContent];
      const zd = $('[data-pk-zd]').textContent;
      if (zd) wiersze.push(zd);
      for (const k of kat) {
        if (k.hidden) continue;
        wiersze.push('', k.querySelector('[data-pk-nazwa]')!.textContent!.toUpperCase());
        for (const p of k.querySelectorAll<HTMLLIElement>('[data-pk-p]:not([hidden])')) {
          const ilosc = p.querySelector('[data-pk-ilosc]')!.textContent;
          wiersze.push(`${odh.has(p.dataset.pkP!) ? '☑' : '☐'} ${p.querySelector('.pk-poz__nazwa')!.textContent}${ilosc ? ' (' + ilosc + ')' : ''}`);
        }
      }
      return wiersze.join('\n');
    };
    $('[data-pk-kopiuj]').addEventListener('click', async () => {
      const t = tekst();
      let ok = false;
      try {
        await navigator.clipboard.writeText(t);
        ok = true;
      } catch {
        // starsze przeglądarki i strona bez uprawnień do schowka: zaznaczenie ukrytego pola
        const p = document.createElement('textarea');
        p.value = t;
        p.setAttribute('readonly', '');
        p.style.cssText = 'position:fixed;opacity:0';
        document.body.append(p);
        p.select();
        ok = document.execCommand('copy');
        p.remove();
      }
      stan.textContent = ok ? 'Skopiowano. Wklej listę do notatek albo wiadomości.' : 'Nie udało się skopiować. Użyj przycisku Drukuj listę.';
    });
    $('[data-pk-zapisz]').addEventListener('click', () => {
      const u = czytaj();
      const nazwa = ['lista-pakowania', norm(u.cel).replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, ''), u.od].filter(Boolean).join('-') + '.txt';
      const a = document.createElement('a');
      a.href = URL.createObjectURL(new Blob(['﻿' + tekst() + '\n\n' + ZN + '\n' + JSON.stringify(dane()) + '\n'], { type: 'text/plain;charset=utf-8' }));
      a.download = nazwa;
      document.body.append(a);
      a.click();
      a.remove();
      setTimeout(() => URL.revokeObjectURL(a.href), 4000);
      stan.textContent = `Zapisano plik ${nazwa}. Znajdziesz go w pobranych plikach.`;
    });

    // Przyjęcie zapisu (pamięć albo plik): sprawdza kształt, odtwarza formularz i listę. Zwraca false przy złym kształcie.
    const przyjmij = (z: any, plik: boolean) => {
      const u = z && z.u;
      if (!u || typeof u !== 'object' || !Array.isArray(z.o) || (z.v !== undefined && z.v !== 1 && z.v !== 2) || (plik && !z.v)) return false;
      if (!['kobieta', 'mezczyzna', 'para', 'para_dzieci', 'sam_dzieci'].includes(u.sklad)) return false;
      const kid = kat.map((k) => k.dataset.pkKat);
      odh.clear();
      z.o.forEach((id: unknown) => typeof id === 'string' && odh.add(id.slice(0, 40)));
      w = (Array.isArray(z.w) ? z.w : [])
        .filter((o: W) => o && /^wl-\d+$/.test(o.id) && kid.includes(o.k) && typeof o.n === 'string' && o.n.trim())
        .map((o: W) => ({ id: o.id, k: o.k, n: tx(o.n), q: Math.min(99, Math.max(1, Math.round(Number(o.q)) || 1)) }));
      x = (Array.isArray(z.x) ? z.x : []).filter((id: unknown) => typeof id === 'string').map((id: string) => id.slice(0, 40));
      ile = {};
      for (const [k, v] of Object.entries(z.i && typeof z.i === 'object' ? z.i : {})) if (Number(v) >= 1 && Number(v) <= 99) ile[k] = Math.round(Number(v));
      ustaw(u);
      renderW();
      zapisuj = true;
      return true;
    };
    const plik = $<HTMLInputElement>('[data-pk-plik]');
    $('[data-pk-wgraj]').addEventListener('click', () => plik.click());
    plik.addEventListener('change', async () => {
      const pl = plik.files?.[0];
      plik.value = '';
      if (!pl) return;
      let z = null;
      try {
        const t = pl.size < 3e5 ? await pl.text() : '';
        const i = t.lastIndexOf(ZN);
        z = JSON.parse(i < 0 ? t : t.slice(i + ZN.length));
      } catch {
        /* nie JSON: komunikat niżej */
      }
      if (!przyjmij(z, true)) {
        stan.textContent = 'To nie jest plik pomocnika pakowania.';
        return;
      }
      generuj();
      doladuj();
      const u = czytaj();
      const p = okres(u.od, u.do);
      const reszta = [u.cel, p ? zakres(u.od, u.do) : ''].filter(Boolean).join(', ');
      stan.textContent = `Wgrano listę z ${new Date(z.d).toLocaleDateString('pl-PL', { day: 'numeric', month: 'long', year: 'numeric' })}${reszta ? ': ' + reszta : ''}.`;
      $('[data-pk-przywrocono]').hidden = true;
    });

    // po odtworzeniu zapisu: dane krajów (i klimat, gdy zapis starszy nie niesie kraju celu) potrzebne do reguł trasy
    const doladuj = () => {
      if (!m) return;
      ladujK();
      if (!m.c || !m.tx) laduj();
    };
    const komunikat = $('[data-pk-przywrocono]');
    $('[data-pk-od-nowa]').addEventListener('click', () => {
      try {
        localStorage.removeItem(KLUCZ);
      } catch {
        /* bez pamięci nie ma czego czyścić */
      }
      zapisuj = false;
      odh.clear();
      m = null;
      s = SPOL;
      reczny = otw = false;
      w = [];
      x = [];
      ile = {};
      renderW();
      f.reset();
      komunikat.hidden = true;
      stan.textContent = '';
      generuj();
      el.cel.focus();
    });

    // Start: przywrócenie zapisu (także starego, bez celu) albo ustawienia domyślne z HTML.
    try {
      const z = JSON.parse(localStorage.getItem(KLUCZ) || 'null');
      if (przyjmij(z, false)) {
        const kiedy = new Date(z.d).toLocaleString('pl-PL', { day: 'numeric', month: 'long', year: 'numeric', hour: '2-digit', minute: '2-digit' });
        $('[data-pk-przywrocono-tekst]').textContent = `Przywrócono twoją ostatnią listę z ${kiedy}.`;
        komunikat.hidden = false;
      }
    } catch {
      /* uszkodzony zapis: start od ustawień domyślnych */
    }
    generuj();
    doladuj();
  }
</script>
