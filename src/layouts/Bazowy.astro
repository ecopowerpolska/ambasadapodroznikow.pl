---
// Bazowy.astro — jedyny layout strony: head (canonical, OG, Twitter, JSON-LD), nagłówek, stopka.
// Bez cookies, bez analityki, bez <ClientRouter /> (strona prawie statyczna). Jedyny skrypt zewnętrzny: GTranslate, ładowany
// dopiero po zgodzie albo po ręcznym wyborze języka (Ciasteczka.astro, Piotr 2026-11-18).
// Ruch (wejścia, licznik, nagłówek po przewinięciu, pasek postępu) = jeden skrypt inline z Ruch.astro, bez bibliotek.
import '../styles/motyw.css';
import '../styles/efekty.css';
import { getImage } from 'astro:assets';
import Naglowek from '../components/Naglowek.astro';
import Stopka from '../components/Stopka.astro';
import Ruch from '../components/Ruch.astro';
import Ciasteczka from '../components/Ciasteczka.astro';
import { t } from '../lib/tekst';
import { zdjecie, ZDJECIE_GLOWNE } from '../lib/zdjecia';

interface Props {
  tytul: string;
  opis: string;
  /** `article` dla wpisu, domyślnie `website`. */
  typOg?: 'website' | 'article';
  /** Bezwzględny adres obrazu do udostępnień; domyślnie kadr 1200×630 ze zdjęcia głównego. */
  obrazOg?: string;
  obrazOgAlt?: string;
  /** Obiekty JSON-LD (schema.org) do wstawienia w <head>. */
  schemat?: Record<string, unknown>[];
  bezIndeksu?: boolean;
  /** Strona błędu 404: adres nie istnieje, więc nie ma canonical (og:url zostaje). */
  bezKanonicznego?: boolean;
  /** Adres pozycji menu do podświetlenia, gdy strona leży poza jej adresem (wpis → jego dział). */
  podswietl?: string;
  /** Pełnoekranowe zdjęcie na samej górze <main> (główna, wpis): nagłówek leży nad nim, przezroczysty do przewinięcia. */
  heroPelny?: boolean;
  /** Pasek postępu czytania (3 px, terakota) u góry okna — strona wpisu. */
  postep?: boolean;
}

const { tytul, opis, typOg = 'website', obrazOg, obrazOgAlt, schemat = [], bezIndeksu = false, bezKanonicznego = false, podswietl, heroPelny = false, postep = false } = Astro.props;
const nazwa = t('marka.nazwa');
const kanoniczny = new URL(Astro.url.pathname, import.meta.env.SITE);

let og = obrazOg;
let ogAlt = obrazOgAlt;
if (!og) {
  const kadr = await getImage({ src: zdjecie(ZDJECIE_GLOWNE), width: 1200, height: 630, fit: 'cover', format: 'jpeg', quality: 80 });
  og = new URL(kadr.src, import.meta.env.SITE).href;
  ogAlt = nazwa;
}
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tytul}</title>
    <meta name="description" content={opis} />
    <meta name="google-site-verification" content="BtiwSnpeg79W3XRknGVla95xI-LvrXFd87SCxVMyYvI" />
    <meta name="robots" content={bezIndeksu ? 'noindex' : 'max-image-preview:large'} />
    {!bezKanonicznego && <link rel="canonical" href={kanoniczny} />}

    <meta property="og:type" content={typOg} />
    <meta property="og:site_name" content={nazwa} />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:title" content={tytul} />
    <meta property="og:description" content={opis} />
    <meta property="og:url" content={kanoniczny} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {ogAlt && <meta property="og:image:alt" content={ogAlt} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={tytul} />
    <meta name="twitter:description" content={opis} />
    <meta name="twitter:image" content={og} />

    <meta name="theme-color" content="#0f3e47" />
    <link rel="icon" href="/favicon.svg?v=20261103" type="image/svg+xml" />
    <link rel="icon" href="/favicon-48.png?v=20261103" type="image/png" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=20261103" />
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="alternate" type="application/rss+xml" title={`${nazwa}: wpisy`} href="/rss.xml" />

    {schemat.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s).replace(/</g, '\\u003c')} />)}
    <noscript><style>.wejscie{opacity:1!important;transform:none!important}</style></noscript>
  </head>
  <body data-hero-pelny={heroPelny ? '' : undefined}>
    {postep && <div class="postep" data-postep aria-hidden="true"></div>}
    <a class="skip" href="#tresc">{t('interfejs.przejdzDoTresci')}</a>
    <Naglowek {podswietl} nadHero={heroPelny} />
    <main id="tresc" tabindex="-1">
      <slot />
    </main>
    <Stopka />
    <Ciasteczka />
    <Ruch />
  </body>
</html>

<style>
  /* Pasek postępu: wygląd w motyw.css (.postep, W1). Tu pierwszeństwo osi przewijania CSS; bez niej --postep ustawia
     Ruch.astro. Same długie właściwości — skrót `animation` z osią minifikator zlewa w zapis, który Chrome odrzuca. */
  @supports (animation-timeline: scroll()) {
    .postep {
      animation-name: postep-pasek;
      animation-timing-function: linear;
      animation-fill-mode: both;
      animation-timeline: scroll(root);
    }
  }

  @keyframes postep-pasek {
    from { transform: scaleX(0); }
    to { transform: scaleX(1); }
  }

  /* Pasek idzie za ręką czytelnika, nie sam z siebie: globalne skrócenie animacji przy reduce by go zamroziło. */
  @media (prefers-reduced-motion: reduce) {
    .postep {
      animation-duration: auto !important;
    }
  }
</style>
