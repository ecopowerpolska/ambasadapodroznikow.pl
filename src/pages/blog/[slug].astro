---
// Wpis: okruszki, tytuł, data, tagi, zdjęcie, treść Markdown (miara 70 znaków), poprzedni i następny.
import { getImage } from 'astro:assets';
import { render } from 'astro:content';
import Bazowy from '../../layouts/Bazowy.astro';
import Okruszki from '../../components/Okruszki.astro';
import Foto from '../../components/Foto.astro';
import { t } from '../../lib/tekst';
import { adresWpisu, dataIso, dataPoPolsku, opublikowane } from '../../lib/wpisy';
import { zdjecie } from '../../lib/zdjecia';
import { adresBezwzgledny, okruszki as schematOkruszkow } from '../../lib/schemat';

export async function getStaticPaths() {
  const wpisy = await opublikowane(); // od najnowszego
  return wpisy.map((wpis, i) => ({
    params: { slug: wpis.id },
    props: {
      wpis,
      nastepny: i > 0 ? wpisy[i - 1] : undefined, // nowszy
      poprzedni: i < wpisy.length - 1 ? wpisy[i + 1] : undefined, // starszy
    },
  }));
}

const { wpis, poprzedni, nastepny } = Astro.props;
const d = wpis.data;
const { Content } = await render(wpis);

const kadrOg = await getImage({ src: zdjecie(d.zdjecie), width: 1200, height: 630, fit: 'cover', format: 'jpeg', quality: 80 });
const obrazOg = adresBezwzgledny(kadrOg.src);
const adres = adresBezwzgledny(adresWpisu(wpis.id));

const pozycje = [
  { nazwa: t('interfejs.okruszki_glowna'), adres: '/' },
  { nazwa: t('interfejs.okruszki_blog'), adres: '/blog/' },
  { nazwa: d.tytul, adres: adresWpisu(wpis.id) },
];
const schemat = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    '@id': `${adres}#wpis`,
    mainEntityOfPage: { '@type': 'WebPage', '@id': adres },
    headline: d.tytul,
    description: d.opis,
    image: [obrazOg],
    datePublished: dataIso(d.data),
    dateModified: dataIso(d.data),
    inLanguage: 'pl-PL',
    keywords: d.tagi.join(', ') || undefined,
    author: { '@id': adresBezwzgledny('/') + '#organizacja', '@type': 'Organization', name: t('marka.nazwa') },
    publisher: { '@id': adresBezwzgledny('/') + '#organizacja', '@type': 'Organization', name: t('marka.nazwa') },
  },
  schematOkruszkow(pozycje),
];
---

<Bazowy tytul={`${d.tytul} | ${t('marka.nazwa')}`} opis={d.opis} typOg="article" {obrazOg} obrazOgAlt={d.alt} {schemat}>
  <Okruszki pozycje={pozycje} />
  <article class="wpis">
    <header class="wpis__glowa kontener">
      <h1>{d.tytul}</h1>
      <div class="wpis__meta">
        <p>
          {t('interfejs.opublikowano')}{' '}
          <time datetime={dataIso(d.data)}>{dataPoPolsku(d.data)}</time>
        </p>
        {
          d.tagi.length > 0 && (
            <ul class="wpis__tagi" aria-label={t('interfejs.tagi_aria')}>
              {d.tagi.map((tag) => <li>{tag}</li>)}
            </ul>
          )
        }
      </div>
    </header>
    <figure class="wpis__zdjecie">
      <Foto
        nazwa={d.zdjecie}
        alt={d.alt}
        widths={[640, 960, 1280, 1600]}
        sizes="(min-width: 64rem) 60rem, 100vw"
        priorytet
      />
    </figure>
    <div class="kontener">
      <div class="tresc">
        <Content />
      </div>
      {
        (poprzedni || nastepny) && (
          <nav class="sasiedzi" aria-label={t('interfejs.sasiedzi_aria')}>
            {poprzedni ? (
              <a class="sasiedzi__poprzedni" href={adresWpisu(poprzedni.id)} rel="prev">
                <span class="sasiedzi__etykieta">{t('interfejs.poprzedni')}</span>
                <span class="sasiedzi__tytul">{poprzedni.data.tytul}</span>
              </a>
            ) : (
              <span></span>
            )}
            {nastepny && (
              <a class="sasiedzi__nastepny" href={adresWpisu(nastepny.id)} rel="next">
                <span class="sasiedzi__etykieta">{t('interfejs.nastepny')}</span>
                <span class="sasiedzi__tytul">{nastepny.data.tytul}</span>
              </a>
            )}
          </nav>
        )
      }
    </div>
  </article>
</Bazowy>
