---
// /polecamy/ — firmy, z którymi pracujemy (teksty.json `polecamy.firmy[]`), a pod nimi zapowiedzi ich najnowszych wpisów
// z RSS (kolekcja `polecane`, najwyżej 12: po 3 z jednej firmy, nie starsze niż 90 dni). Zastępuje dawne /z-naszych-stron/ (przekierowanie w docs/przekierowania.json).
// Odnośnik do firmy: rel="nofollow" (blok polecający; link w treści wpisu bez rel — schemat Piotra 2026-10-26). Bez logo, ocen i cen.
import Bazowy from '../layouts/Bazowy.astro';
import Okruszki from '../components/Okruszki.astro';
import KartaPolecana from '../components/KartaPolecana.astro';
import { t, pobierz, wstaw } from '../lib/tekst';
import { polecaneRozne } from '../lib/wpisy';
import { adresBezwzgledny, okruszki } from '../lib/schemat';

type Firma = { nazwa: string; adres: string; opis: string; coDlaNas: string };
const tekst = (w: unknown) => (typeof w === 'string' ? w.trim() : '');
const firmy: Firma[] = (Array.isArray(pobierz('polecamy.firmy')) ? (pobierz('polecamy.firmy') as Record<string, unknown>[]) : [])
  .map((f) => ({ nazwa: tekst(f?.nazwa), adres: tekst(f?.adres), opis: tekst(f?.opis), coDlaNas: tekst(f?.coDlaNas) }))
  .filter((f) => f.nazwa !== '' && /^https?:\/\//.test(f.adres));

// Wstęp opcjonalny: pusty tekst = bez akapitu (t() dla pustego daje „[brak: …]”, więc czytamy wprost).
const wstep = tekst(pobierz('polecamy.wstep'));
const zapowiedzi = (await polecaneRozne(3)).slice(0, 12);
// Napis odnośnika do firmy: `polecamy.odwiedz` („Odwiedź {nazwa}”), a bez tego klucza sama nazwa firmy.
const napisOdwiedz = t('polecamy.odwiedz', '{nazwa}');
const host = (adres: string) => new URL(adres).hostname.replace(/^www\./, '');

const pozycje = [
  { nazwa: t('interfejs.okruszki_glowna'), adres: '/' },
  { nazwa: t('polecamy.h1'), adres: '/polecamy/' },
];
const schemat = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    '@id': `${adresBezwzgledny('/polecamy/')}#polecamy`,
    name: t('polecamy.h1'),
    description: t('polecamy.opisMeta'),
    url: adresBezwzgledny('/polecamy/'),
    inLanguage: 'pl-PL',
    isPartOf: { '@id': `${adresBezwzgledny('/')}#strona` },
    ...(firmy.length > 0 && {
      mainEntity: {
        '@type': 'ItemList',
        itemListElement: firmy.map((f, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          item: { '@type': 'Organization', name: f.nazwa, url: f.adres },
        })),
      },
    }),
  },
  okruszki(pozycje),
];
---

<Bazowy tytul={t('polecamy.tytulKarty')} opis={t('polecamy.opisMeta')} {schemat}>
  <div class="sekcja--aurora polecamy-firmy">
    <Okruszki pozycje={pozycje} />
    <div class="kontener podstrona-glowa">
      <p class="etykieta">{t('polecamy.etykieta')}</p>
      <h1 class="polecamy__tytul">{t('polecamy.h1')}</h1>
      {wstep !== '' && <p class="podstrona-glowa__wstep polecamy__wstep">{wstep}</p>}
    </div>

    <div class="kontener polecamy-firmy__rama">
      <ul class="firmy">
        {
          firmy.map((f, i) => (
            <li class="firma szklo szklo--jasne wejscie" style={`--i:${i % 3}`}>
              <h2>{f.nazwa}</h2>
              {f.coDlaNas && <p class="firma__dla-nas">{f.coDlaNas}</p>}
              {f.opis && <p>{f.opis}</p>}
              <p class="firma__strona">
                <a class="guzik guzik--twardy" href={f.adres} rel="nofollow">{wstaw(napisOdwiedz, { nazwa: f.nazwa })}</a>
                <span class="firma__host">{host(f.adres)}</span>
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <section class="sekcja" aria-labelledby="zapowiedzi">
    <div class="kontener">
      <div class="sekcja__glowa wejscie">
        <div>
          <p class="etykieta">{t('polecamy.etykietaZapowiedzi')}</p>
          <h2 id="zapowiedzi" class="polecamy__tytul-sekcji">{t('polecamy.naglowekZapowiedzi')}</h2>
          <p class="sekcja__wstep polecamy__wstep">{t('polecamy.wstepZapowiedzi')}</p>
        </div>
      </div>
      {
        zapowiedzi.length > 0 ? (
          <ul class="karty">
            {zapowiedzi.map((w, i) => (
              <li class="wejscie" style={`--i:${i % 3}`}>
                <KartaPolecana wpis={w} napis={t('polecamy.czytajDalej', t('interfejs.czytajDalejNa'))} />
              </li>
            ))}
          </ul>
        ) : (
          <p class="pusto">{t('interfejs.brakPolecanych')}</p>
        )
      }
    </div>
  </section>
</Bazowy>

<style>
  /* Firmy: szklane jasne karty na tle aurora, 2–3 kolumny; odnośnik do firmy = guzik pigułka z twardym cieniem.
     href, napis i rel="nofollow" bez zmian (strażnik scripts/sprawdz-linki-firm.mjs). */
  .polecamy-firmy {
    padding-bottom: var(--o-16);
  }

  .polecamy__tytul {
    margin-top: var(--o-3);
    font-size: var(--t-sekcji, clamp(1.875rem, 4vw, 3.25rem));
    line-height: 1.05;
  }

  @media (min-width: 48rem) {
    .podstrona-glowa .polecamy__tytul {
      font-size: var(--t-sekcji, clamp(1.875rem, 4vw, 3.25rem));
    }
  }

  .polecamy__tytul-sekcji {
    font-size: var(--t-sekcji, clamp(1.875rem, 4vw, 3.25rem));
    line-height: 1.05;
  }

  .polecamy__wstep {
    max-width: none;
  }

  .firmy {
    gap: var(--o-6);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
    margin: 0;
    padding: 0;
  }

  /* kontrast: #1a2a2e na szkle jasnym .7 nad najciemniejszym punktem aurory (W1: nad czernią #aca8a0 6,27:1) */
  .firma {
    padding: var(--o-6);
    border: 1px solid rgb(255 255 255 / 0.5);
    box-shadow: var(--cien-miekki);
  }

  .firma h2 {
    font-size: var(--t-5);
    line-height: 1.15;
  }

  .firma p {
    max-width: none;
  }

  .firma__host {
    color: #1a2a2e;
  }

  @media (prefers-reduced-motion: no-preference) {
    .firma {
      transition: transform var(--ruch-plynny, 320ms ease), box-shadow var(--ruch-plynny, 320ms ease), opacity var(--ruch-wejscia, 600ms ease);
    }

    .firma.wejscie--widoczne:hover {
      transition-delay: 0s;
      transform: translateY(-4px);
      box-shadow: var(--cien-uniesiony);
    }
  }
</style>
